# holaday-admin — the internal authoring workspace Supabase project.
# The anon key is safe to expose client-side; write access is enforced
# by Postgres RLS (see supabase/admin/migrations) requiring the caller's
# auth.uid() to be present in admin_users, which has no self-serve signup.
VITE_SUPABASE_URL=https://ckombvjqrqayhtadwrkz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_OviLLebWKubdNwIfmbBehQ_JRWUCx0y

# holaday-content's Edge Functions endpoint — every "Publish" action
# calls publish-record there (see supabase/content/functions/publish-record).
# It's deployed in holaday-content, not here, so it can use that
# project's own service-role credentials for the content-side write
# without a manually-configured cross-project secret; see that
# function's header comment for the full rationale.
VITE_CONTENT_FUNCTIONS_URL=https://ozbilvkvnixeazzdxueb.supabase.co/functions/v1

# ----------------------------------------------------------------
# NOT read by Vite (no VITE_ prefix) — these are consumed server-side
# by the Cloudflare Pages Functions in apps/admin/functions/
# (persona-flesh.js, persona-generate-content.js) via `env.*`, not by
# the client bundle. They're only set in the Cloudflare Pages project's
# environment variables, not in a local .env — listed here purely as
# documentation of what that project needs configured.
#   SUPABASE_URL       = same value as VITE_SUPABASE_URL above
#   SUPABASE_ANON_KEY   = same value as VITE_SUPABASE_ANON_KEY above
#   ANTHROPIC_API_KEY   = encrypted secret, no local equivalent
# ----------------------------------------------------------------
